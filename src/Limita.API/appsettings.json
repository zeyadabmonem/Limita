{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=LimitaDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "Limita.API",
    "Audience": "Limita.Client",
    "Key": "REPLACE_WITH_A_LONG_RANDOM_SECRET_IN_USER_SECRETS_OR_ENV_VARS",
    "ExpiryMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
